# Public site URL (no trailing slash) — used for canonicals, sitemap, robots, schema
# Vercel: Project → Settings → Environment Variables
# Key:   NEXT_PUBLIC_SITE_URL
# Value: https://www.jeffstowingandrecovery.com
NEXT_PUBLIC_SITE_URL=https://www.jeffstowingandrecovery.com

# Google Analytics 4 measurement ID
# Vercel: Project → Settings → Environment Variables
# Key:   NEXT_PUBLIC_GA_MEASUREMENT_ID
# Value: G-XBNG8M4GGQ
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification content value
# Vercel: Project → Settings → Environment Variables
# Key:   NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION
# Value: BXbzOEmZ3RIZs4JolqmUl22R3gSQeuYMQLnnfrzQyos
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=BXbzOEmZ3RIZs4JolqmUl22R3gSQeuYMQLnnfrzQyos

# Cloudflare Turnstile (contact form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
