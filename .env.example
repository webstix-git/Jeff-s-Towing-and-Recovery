# Public site URL (no trailing slash) — used for canonicals, sitemap, robots, schema
NEXT_PUBLIC_SITE_URL=https://jeffstowing.com

# Google Analytics 4 measurement ID
# Vercel: Project → Settings → Environment Variables
# Key:   NEXT_PUBLIC_GA_MEASUREMENT_ID
# Value: G-XBNG8M4GGQ
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cloudflare Turnstile (contact form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
